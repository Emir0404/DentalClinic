@{ ViewData["Title"] = "Moj termin"; }
<section class="page-head">
    <div class="container">
        <div class="crumbs"><a href="/">Početna</a> / Moj termin</div>
        <h1>Pronađite svoj termin</h1>
        <p>Unesite šifru iz potvrde i email adresu koju ste ostavili pri zakazivanju.</p>
    </div>
</section>
<section class="section tight">
    <div class="container narrow" style="width:min(520px,100% - 40px)">
        <form method="post" class="form-card">
            @if (ViewBag.Error is string err) { <div class="alert err" role="alert">@err</div> }
            <div class="field"><label for="reference">Šifra termina</label><input id="reference" name="reference" placeholder="DS-XXXXXX" required autocomplete="off" /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
            <button class="btn btn-teal btn-block" type="submit">Pronađi termin</button>
        </form>
        <p class="center muted small" style="margin-top:1.2rem">Izgubili ste šifru? Nazovite nas na <a href="tel:@ClinicInfo.PhoneLink">@ClinicInfo.Phone</a>.</p>
    </div>
</section>
