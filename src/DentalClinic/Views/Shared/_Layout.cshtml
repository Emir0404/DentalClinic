<!DOCTYPE html>
<html lang="bs">
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    string Cur(string prefix) => (prefix == "/" ? path == "/" : path.StartsWith(prefix)) ? "page" : "";
    var title = ViewData["Title"] is string t ? $"{t} · {ClinicInfo.Name}" : $"{ClinicInfo.Name}: zubar u Sarajevu";
    var description = ViewData["Description"] as string
        ?? "Moderna stomatološka ordinacija u Sarajevu. Online zakazivanje termina, cijena unaprijed, blag pristup odraslima i djeci.";
    var image = ViewData["Image"] as string ?? "/img/hero.jpg";
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#0a4f56" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:image" content="@origin@image" />
    <meta property="og:locale" content="bs_BA" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%230f6b73'/><text x='50' y='70' font-size='60' text-anchor='middle'>🦷</text></svg>" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @* Ikonice se definišu jednom, a koriste svuda preko <use href="#i-naziv"> *@
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="i-tooth" viewBox="0 0 24 24"><path d="M7 4C5 4 3.5 5.6 3.5 8c0 2 .8 3.500 1.500 5.500.7 2 .8 6.500 2.500 6.500 1.400 0 1.500-4 2.500-4s1.100 4 2.500 4c1.700 0 1.800-4.500 2.500-6.500.7-2 1.500-3.500 1.500-5.500 0-2.400-1.500-4-3.500-4-1.500 0-2 .8-3 .8S8.500 4 7 4z"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></symbol>
        <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></symbol>
        <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s7-6.200 7-11a7 7 0 1 0-14 0c0 4.800 7 11 7 11z"/><circle cx="12" cy="10" r="2.500"/></symbol>
        <symbol id="i-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></symbol>
        <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.500-3.200 8.200-8 9-4.800-.8-8-4.500-8-9V6l8-3z"/><path d="M8.500 12l2.500 2.500L16 9.500"/></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></symbol>
        <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3l2.700 5.600 6.100.9-4.400 4.300 1 6.100L12 17l-5.400 2.900 1-6.100L3.200 9.500l6.100-.9L12 3z"/></symbol>
        <symbol id="i-heart" viewBox="0 0 24 24"><path d="M12 20s-7-4.400-7-10a4 4 0 0 1 7-2.500A4 4 0 0 1 19 10c0 5.600-7 10-7 10z"/></symbol>
        <symbol id="i-smile" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 14s1.500 2 4 2 4-2 4-2M9 9.500h.01M15 9.500h.01"/></symbol>
        <symbol id="i-sparkle" viewBox="0 0 24 24"><path d="M12 3l1.800 5.200L19 10l-5.200 1.800L12 17l-1.800-5.200L5 10l5.200-1.800L12 3zM19 16l.8 2.200L22 19l-2.200.8L19 22l-.8-2.200L16 19l2.200-.8L19 16z"/></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.600-6 8-6s8 2 8 6"/></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.500"/><path d="M2 20c0-3.500 3-5.500 7-5.500s7 2 7 5.500M16 4.500a3.500 3.500 0 0 1 0 7M18 14.800c2.200.7 4 2.300 4 5.200"/></symbol>
        <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
        <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3l10 18H2L12 3z"/><path d="M12 10v4M12 17.500v.1"/></symbol>
        <symbol id="i-euro" viewBox="0 0 24 24"><path d="M18 6.500A7 7 0 1 0 18 17.500M4 10h9M4 14h9"/></symbol>
        <symbol id="i-award" viewBox="0 0 24 24"><circle cx="12" cy="9" r="6"/><path d="M8.500 14L7 21l5-3 5 3-1.500-7"/></symbol>
    </svg>

    <div class="topbar">
        <div class="container">
            <span><svg class="ic"><use href="#i-clock"/></svg> @ClinicInfo.HoursWeek <span class="hide-sm">· @ClinicInfo.HoursSaturday</span></span>
            <span><span class="urgent hide-sm">Hitan slučaj?</span> <svg class="ic"><use href="#i-phone"/></svg> <a href="tel:@ClinicInfo.PhoneLink">@ClinicInfo.Phone</a></span>
        </div>
    </div>

    <header class="header" id="header">
        <div class="container">
            <a class="brand" href="/" aria-label="@ClinicInfo.Name, početna stranica">
                <span class="brand-mark"><svg class="ic"><use href="#i-tooth"/></svg></span>
                <span class="brand-text"><b>Osmijeh</b><small>Dental Studio</small></span>
            </a>
            <button class="burger" id="burger" type="button" aria-label="Otvori meni" aria-expanded="false" aria-controls="nav"><span></span><span></span><span></span></button>
            <nav class="nav" id="nav" aria-label="Glavni meni">
                <a href="/usluge" aria-current="@Cur("/usluge")">Usluge</a>
                <a href="/tim" aria-current="@Cur("/tim")">Naš tim</a>
                <a href="/cjenovnik" aria-current="@Cur("/cjenovnik")">Cjenovnik</a>
                <a href="/savjeti" aria-current="@Cur("/savjeti")">Savjeti</a>
                <a href="/kontakt" aria-current="@Cur("/kontakt")">Kontakt</a>
                <a class="btn btn-primary btn-sm" href="/zakazivanje">Zakaži termin</a>
                <div class="nav-extra">
                    <b>Hitan slučaj? Nazovite nas</b>
                    <a href="tel:@ClinicInfo.PhoneLink">@ClinicInfo.Phone</a>
                    <div style="margin-top:.5rem">@ClinicInfo.HoursWeek<br />@ClinicInfo.HoursSaturday</div>
                </div>
            </nav>
        </div>
    </header>

    <main id="main">@RenderBody()</main>

    <footer class="footer">
        <div class="container footer-grid">
            <div>
                <a class="brand" href="/"><span class="brand-mark"><svg class="ic"><use href="#i-tooth"/></svg></span><span class="brand-text"><b>Osmijeh</b><small>Dental Studio</small></span></a>
                <p>Moderna ordinacija u srcu Sarajeva. Liječimo blago, objašnjavamo jasno i cijenu kažemo unaprijed.</p>
            </div>
            <div>
                <h4>Ordinacija</h4>
                <a href="/usluge">Usluge</a>
                <a href="/tim">Naš tim</a>
                <a href="/cjenovnik">Cjenovnik</a>
                <a href="/savjeti">Savjeti</a>
                <a href="/pitanja">Česta pitanja</a>
            </div>
            <div>
                <h4>Pacijenti</h4>
                <a href="/zakazivanje">Zakaži termin</a>
                <a href="/zakazivanje/moj-termin">Moj termin</a>
                <a href="/kontakt">Kontakt</a>
                <a href="/privatnost">Privatnost</a>
            </div>
            <div>
                <h4>Kontakt</h4>
                <p>@ClinicInfo.Address<br /><a href="tel:@ClinicInfo.PhoneLink" style="display:inline">@ClinicInfo.Phone</a><br /><a href="mailto:@ClinicInfo.Email" style="display:inline">@ClinicInfo.Email</a></p>
                <p>@ClinicInfo.HoursWeek<br />@ClinicInfo.HoursSaturday<br />@ClinicInfo.HoursSunday</p>
            </div>
        </div>
        <div class="container copyright">
            <span>© @DateTime.Now.Year @ClinicInfo.Name. Demo sajt: sva imena, cijene i adresa su izmišljeni.</span>
            <span>Fotografije: <a href="https://unsplash.com" rel="noopener" target="_blank">Unsplash</a></span>
        </div>
    </footer>

    <div class="callbar" aria-label="Brze akcije">
        <a class="btn btn-outline btn-sm" href="tel:@ClinicInfo.PhoneLink"><svg class="ic"><use href="#i-phone"/></svg> Pozovi</a>
        <a class="btn btn-primary btn-sm" href="/zakazivanje"><svg class="ic"><use href="#i-calendar"/></svg> Zakaži termin</a>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
